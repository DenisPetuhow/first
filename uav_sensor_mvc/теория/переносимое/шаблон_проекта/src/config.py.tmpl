# -*- coding: utf-8 -*-
"""ПАРАМЕТРЫ ПРОГРАММЫ «{{ПРОЕКТ}}» — все числа и умолчания в одном месте; в коде их не разбрасывать."""
from dataclasses import dataclass


@dataclass
class Params:
    """Параметры расчёта, задаваемые в интерфейсе. Вход: нет. Отдаёт: набор полей с умолчаниями."""
    seed: int = 1000               # зерно случайных чисел — повторяемость прогонов
